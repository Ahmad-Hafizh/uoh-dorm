// prisma/schema.prisma
//------------------------------------------------------------
//  PostgreSQL datasource
//------------------------------------------------------------
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//------------------------------------------------------------
//  Prisma client generator (v5)
//------------------------------------------------------------
generator client {
  provider = "prisma-client-js"
}

//------------------------------------------------------------
//  ENUMS
//------------------------------------------------------------
enum ResidenceStatus {
  INSIDE_SAKAN
  OUTSIDE_SAKAN
}

enum AcademicStatus {
  ACTIVE
  ON_LEAVE
}

enum QuestionType {
  TEXT
  TEXTAREA
  SINGLE_CHOICE
  MULTI_CHOICE
  NUMBER
  DATE
  TIME
  DROPDOWN
  FILE
}

enum Role {
  ADMIN
  STAFF
  STUDENT
}

enum ComplaintStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  REJECTED
}

enum ComplaintPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

//------------------------------------------------------------
//  BETTER AUTH CORE MODELS (UPDATED)
//------------------------------------------------------------

model User {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @map("email_verified")
  image         String?
  createdAt     DateTime  @map("created_at")
  updatedAt     DateTime  @map("updated_at")

  // Custom fields
  role                    String    @default("STUDENT")
  announcementsLastReadAt DateTime? @map("announcements_last_read_at")
  permissionsLastReadAt   DateTime? @map("permissions_last_read_at")

  // Relasi Better Auth
  sessions      Session[]
  accounts      Account[]

  // Relasi Domain Aplikasi
  student                Student?          
  formResponses          FormResponse[]
  complaintsSubmitted    Complaint[]       @relation("StudentComplaints")
  complaintsAssigned     Complaint[]       @relation("AssignedComplaints")
  complaintMessages      ComplaintMessage[]

  @@map("user")
}

model Session {
  id        String   @id @default(uuid())
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(uuid())
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @map("created_at")
  updatedAt             DateTime  @map("updated_at")

  @@map("account")
}

model Verification {
  id         String    @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime? @map("created_at")
  updatedAt  DateTime? @map("updated_at")

  @@map("verification")
}

//------------------------------------------------------------
//  DOMAIN MODELS
//------------------------------------------------------------

model Student {
  id              String          @id @default(uuid())
  user_id         String          @unique @map("user_id")
  user            User            @relation(fields: [user_id], references: [id], onDelete: Cascade)

  universityId    String          @unique @map("university_id")
  arabicName      String          @map("arabic_name")
  englishName     String          @map("english_name")
  nationality     String
  phone           String
  arrivalDate     DateTime?       @map("arrival_date")
  programStudy    String          @map("program_study")
  academicYear    String          @map("academic_year")
  residenceStatus ResidenceStatus @default(INSIDE_SAKAN) @map("residence_status")
  roomNumber      String?         @map("room_number")
  address         String?
  academicStatus  AcademicStatus  @default(ACTIVE) @map("academic_status")
  passportNumber  String          @map("passport_number")
  passportExpiry  DateTime        @map("passport_expiry")
  iqamahNumber    String          @map("iqamah_number")
  iqamahExpiry    DateTime        @map("iqamah_expiry")
  adminNotes      String?         @map("admin_notes")
  photoUrl        String?         @map("photo_url")
  passportFileId  String?         @map("passport_file_id")
  iqamahFileId    String?         @map("iqamah_file_id")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime?       @updatedAt   @map("updated_at")

  @@map("students")
}

model StudyProgram {
  id         String   @id @default(uuid())
  name_ar    String   @map("name_ar")
  name_en    String   @map("name_en")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime? @updatedAt   @map("updated_at")

  @@map("study_programs")
}

model ComplaintCategory {
  id         String    @id @default(uuid())
  name       String
  description String?
  is_active  Boolean   @default(true) @map("is_active")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime? @updatedAt   @map("updated_at")
  complaints Complaint[]

  @@map("complaint_categories")
}

model Complaint {
  id               String            @id @default(uuid())
  ticket_number    String            @unique @map("ticket_number")
  title            String
  description      String
  location_details String?           @map("location_details")
  attachments      Json?             
  status           ComplaintStatus   @default(PENDING)
  priority         ComplaintPriority @default(MEDIUM)
  categoryId       String            @map("category_id")
  studentId        String            @map("student_id")
  assignedToId     String?           @map("assigned_to_id")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime?         @updatedAt   @map("updated_at")

  category   ComplaintCategory @relation(fields: [categoryId], references: [id])
  student    User              @relation("StudentComplaints", fields: [studentId], references: [id], onDelete: Cascade)
  assignedTo User?             @relation("AssignedComplaints", fields: [assignedToId], references: [id])
  messages   ComplaintMessage[]

  @@map("complaints")
}

model ComplaintMessage {
  id               String   @id @default(uuid())
  complaintId      String   @map("complaint_id")
  senderId         String   @map("sender_id")
  message          String
  attachments      Json?
  is_internal_note Boolean  @default(false) @map("is_internal_note")
  createdAt        DateTime @default(now()) @map("created_at")

  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  sender    User      @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@map("complaint_messages")
}

model DocumentRequest {
  id                  String   @id @default(uuid())
  user_id             String   @map("user_id")
  user_name           String   @map("user_name")
  request_type        String   @map("request_type")
  notes               String?
  attachment_file_ids Json?    @map("attachment_file_ids")
  status              String
  admin_note          String?  @map("admin_note")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime? @updatedAt   @map("updated_at")

  @@map("document_requests")
}

model FileRecord {
  id                String   @id @default(uuid())
  storage_path      String   @map("storage_path")
  original_filename String   @map("original_filename")
  content_type      String   @map("content_type")
  size              Int
  kind              String
  uploaded_by       String   @map("uploaded_by")
  is_deleted        Boolean? @default(false) @map("is_deleted")
  createdAt         DateTime @default(now()) @map("created_at")

  @@map("files")
}

model Announcement {
  id          String   @id @default(uuid())
  title_en    String   @map("title_en")
  title_ar    String   @map("title_ar")
  body_en     String   @map("body_en")
  body_ar     String   @map("body_ar")
  pinned      Boolean? @default(false)
  author_name String   @map("author_name")
  form_id     String?  @map("form_id")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("announcements")
}

model Permission {
  id               String   @id @default(uuid())
  user_id          String   @map("user_id")
  user_name        String   @map("user_name")
  permission_type  String   @map("permission_type")
  destination      String
  start_date       DateTime @map("start_date")
  end_date         DateTime @map("end_date")
  reason           String
  status           String   @default("PENDING")
  admin_note       String?  @map("admin_note")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime? @updatedAt   @map("updated_at")

  @@map("permissions")
}

model Form {
  id             String   @id @default(uuid())
  title          String
  description    String?
  closes_at      DateTime? @map("closes_at")
  is_active      Boolean  @default(true) @map("is_active")
  is_closed      Boolean? @default(false) @map("is_closed")
  created_by     String   @map("created_by")
  author_name    String   @map("author_name")
  response_count Int?     @default(0) @map("response_count")
  createdAt      DateTime @default(now()) @map("created_at")
  questions      Question[]
  form_responses FormResponse[]

  @@map("forms")
}

model Question {
  id          String       @id @default(uuid())
  form_id     String       @map("form_id")
  label       String
  type        QuestionType @default(TEXT)
  is_required Boolean      @default(false) @map("is_required")
  options     Json?
  order       Int?         @default(0)
  form        Form         @relation(fields: [form_id], references: [id], onDelete: Cascade)

  @@map("questions")
}

model FormResponse {
  id         String   @id @default(uuid())
  form_id    String   @map("form_id")
  user_id    String   @map("user_id")
  user_name  String   @map("user_name")
  answers    Json
  submittedAt DateTime @default(now()) @map("submitted_at")
  updatedAt   DateTime? @updatedAt   @map("updated_at")

  form  Form @relation(fields: [form_id], references: [id], onDelete: Cascade)
  user  User @relation(fields: [user_id], references: [id])

  @@map("form_responses")
}